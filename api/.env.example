# Copie para .env:  copy .env.example .env   (Windows)  |  cp .env.example .env   (Linux/macOS)

# --- Base de dados (usada pelo contentor "db") ---
POSTGRES_USER=projetoemdia
POSTGRES_PASSWORD=projetoemdia
POSTGRES_DB=projetoemdia

# Só é usado quando corre a API FORA do Docker (npm run start:dev).
# Dentro do Docker o docker-compose substitui este valor (host "db").
DATABASE_URL="postgresql://projetoemdia:projetoemdia@localhost:5432/projetoemdia?schema=public"

# --- API ---
PORT=3000
# Fuso horário do utilizador em minutos face ao UTC (Maputo = +2h = 120). Usado em "Tarefas para Hoje".
APP_UTC_OFFSET_MINUTES=120

# --- JWT --- (MUDE em produção: use valores longos e aleatórios, p. ex. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=mude-isto-access-secret
JWT_REFRESH_SECRET=mude-isto-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
