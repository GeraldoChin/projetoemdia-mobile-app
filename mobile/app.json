{
  "expo": {
    "name": "ProjetoEmDia",
    "slug": "projetoemdia",
    "scheme": "projetoemdia",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F8F9FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.mz.projetoemdia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.mz.projetoemdia",
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#F8F9FB",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#102B4E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher uma foto para o teu perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2ad18648-e57d-463a-9a0e-97ff758f349b"
      }
    },
    "owner": "chingeraldo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2ad18648-e57d-463a-9a0e-97ff758f349b"
    }
  }
}
